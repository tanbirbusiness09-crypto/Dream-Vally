# ==========================================
# Dreamvally PostgreSQL Database Environment Variables
# ==========================================

# 1. PostgreSQL Connection URL (Supabase, Neon, or Local Postgres)
# Example Supabase: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# Example Neon: postgresql://[user]:[password]@[endpoint].neon.tech/dreamvally?sslmode=require
# Example Local: postgresql://postgres:password@localhost:5432/dreamvally?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/dreamvally?schema=public"

# 2. NextAuth / Authentication Secret
NEXTAUTH_SECRET="your-super-secret-jwt-key-here"
NEXTAUTH_URL="http://localhost:3000"

# 3. Cloudflare R2 / AWS S3 Object Storage (For User & Product Images)
CLOUDFLARE_R2_ACCOUNT_ID="your-r2-account-id"
CLOUDFLARE_R2_ACCESS_KEY_ID="your-r2-access-key"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your-r2-secret-key"
CLOUDFLARE_R2_BUCKET_NAME="dreamvally-media"
CLOUDFLARE_R2_PUBLIC_DOMAIN="https://media.dreamvally.com"

# 4. SMS Gateway (For BD & SA Phone Verification / OTP)
SMS_GATEWAY_API_KEY="your-sms-api-key"
SMS_SENDER_ID="Dreamvally"
