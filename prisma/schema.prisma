// This is your Prisma schema file for Dreamvally PostgreSQL Database
// Dual-market marketplace for Bangladesh (BD) and Saudi Arabia (SA)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------

enum UserRole {
  BUYER
  SELLER
  VERIFIED_MERCHANT
  ADMIN
  MODERATOR
}

enum MarketRegion {
  BD     // Bangladesh
  SA     // Saudi Arabia
  BOTH   // Dual Market
}

enum Currency {
  BDT    // Bangladeshi Taka
  SAR    // Saudi Riyal
  USD
}

enum ItemCondition {
  BRAND_NEW
  LIKE_NEW
  USED
  REFURBISHED
}

enum ListingStatus {
  ACTIVE
  PENDING_REVIEW
  SOLD
  EXPIRED
  DRAFT
  REJECTED
  ARCHIVED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  COUNTERED
  EXPIRED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID_ESCROW
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
  DISPUTED
}

// ----------------------------------------------------
// USER & SELLER ACCOUNTS
// ----------------------------------------------------

model User {
  id              String        @id @default(cuid())
  email           String?       @unique
  phoneNumber     String        @unique
  passwordHash    String?
  fullName        String
  avatarUrl       String?
  role            UserRole      @default(BUYER)
  primaryMarket   MarketRegion  @default(BD)
  isPhoneVerified Boolean       @default(false)
  isKycVerified   Boolean       @default(false)
  nationalId      String?
  
  // Verification Documents (uploaded file paths under /uploads/)
  nidFrontUrl     String?
  nidBackUrl      String?
  tradeLicenseUrl String?
  kycSubmittedAt  DateTime?
  
  // Merchant / Seller Specific Fields
  shopName        String?
  shopSlug        String?       @unique
  shopDescription String?
  shopLogo        String?
  shopBanner      String?
  sellerRating    Float         @default(5.0)
  totalReviews    Int           @default(0)
  
  // Location
  country         String        @default("Bangladesh")
  division        String?
  district        String?
  city            String?
  address         String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relationships
  listings        Listing[]
  sentOffers      Offer[]       @relation("BuyerOffers")
  receivedOffers  Offer[]       @relation("SellerOffers")
  favorites       Favorite[]
  buyerOrders     Order[]       @relation("BuyerOrders")
  sellerOrders    Order[]       @relation("SellerOrders")
  sentMessages    Message[]     @relation("SentMessages")
  conversationsAsBuyer  Conversation[] @relation("ConversationBuyer")
  conversationsAsSeller Conversation[] @relation("ConversationSeller")
  reviewsGiven    Review[]      @relation("BuyerReviews")
  reviewsReceived Review[]      @relation("SellerReviews")

  @@index([phoneNumber])
  @@index([email])
  @@index([role])
}

// ----------------------------------------------------
// CATEGORY TAXONOMY
// ----------------------------------------------------

model Category {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  iconName    String?     // Lucide or Material Icon identifier
  imageUrl    String?
  description String?
  parentId    String?
  sortOrder   Int         @default(0)
  isActive    Boolean     @default(true)

  parent      Category?   @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[]  @relation("CategoryHierarchy")
  listings    Listing[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([slug])
  @@index([parentId])
}

// ----------------------------------------------------
// LISTINGS & ADS
// ----------------------------------------------------

model Listing {
  id                String         @id @default(cuid())
  title             String
  slug              String         @unique
  description       String
  
  // Pricing & Currency
  price             Decimal        @db.Decimal(12, 2)
  currency          Currency       @default(BDT)
  isNegotiable      Boolean        @default(true)
  discountPercent   Int?           @default(0)
  originalPrice     Decimal?       @db.Decimal(12, 2)

  // Inventory & Tracking
  stock             Int            @default(1)
  sku               String?        @unique
  barcode           String?
  
  // Product Quality & Status
  condition         ItemCondition  @default(USED)
  status            ListingStatus  @default(ACTIVE)
  targetMarket      MarketRegion   @default(BD)
  
  // Escrow & Delivery Support
  deliveryAvailable Boolean        @default(false)
  deliveryFee       Decimal?       @db.Decimal(10, 2)
  isInspectionPassed Boolean       @default(false)

  // Dynamic Category Specifications (PostgreSQL JSONB)
  // e.g. { "ram": "8GB", "storage": "256GB", "year": 2024, "mileage": 12000, "sqft": 1850 }
  attributes        Json?          @default("{}")

  // Geolocation
  country           String         @default("Bangladesh")
  division          String?
  district          String?
  city              String?
  area              String?
  latitude          Float?
  longitude         Float?

  // Engagement Metrics
  viewsCount        Int            @default(0)
  likesCount        Int            @default(0)

  // Relationships
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  categoryId        String
  category          Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  images            ListingImage[]
  offers            Offer[]
  favorites         Favorite[]
  orderItems        OrderItem[]
  reviews           Review[]

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([status])
  @@index([categoryId])
  @@index([userId])
  @@index([targetMarket])
  @@index([price])
  @@index([city, district])
  @@index([createdAt])
}

model ListingImage {
  id          String   @id @default(cuid())
  url         String
  altText     String?
  isPrimary   Boolean  @default(false)
  sortOrder   Int      @default(0)
  
  listingId   String
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@index([listingId])
}

// ----------------------------------------------------
// NEGOTIATION & OFFERS
// ----------------------------------------------------

model Offer {
  id            String       @id @default(cuid())
  offerAmount   Decimal      @db.Decimal(12, 2)
  currency      Currency     @default(BDT)
  status        OfferStatus  @default(PENDING)
  note          String?

  listingId     String
  listing       Listing      @relation(fields: [listingId], references: [id], onDelete: Cascade)

  buyerId       String
  buyer         User         @relation("BuyerOffers", fields: [buyerId], references: [id], onDelete: Cascade)

  sellerId      String
  seller        User         @relation("SellerOffers", fields: [sellerId], references: [id], onDelete: Cascade)

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([listingId])
  @@index([buyerId])
  @@index([sellerId])
}

// ----------------------------------------------------
// SAVED / FAVORITE ADS
// ----------------------------------------------------

model Favorite {
  id          String    @id @default(cuid())
  
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  listingId   String
  listing     Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())

  @@unique([userId, listingId])
  @@index([userId])
}

// ----------------------------------------------------
// IN-APP CHAT (BUYER & SELLER)
// ----------------------------------------------------

model Conversation {
  id            String     @id @default(cuid())
  
  buyerId       String
  buyer         User       @relation("ConversationBuyer", fields: [buyerId], references: [id], onDelete: Cascade)

  sellerId      String
  seller        User       @relation("ConversationSeller", fields: [sellerId], references: [id], onDelete: Cascade)

  lastMessageAt DateTime   @default(now())
  messages      Message[]

  createdAt     DateTime   @default(now())

  @@unique([buyerId, sellerId])
  @@index([buyerId])
  @@index([sellerId])
}

model Message {
  id              String        @id @default(cuid())
  content         String
  isRead          Boolean       @default(false)

  conversationId  String
  conversation    Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId        String
  sender          User          @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  createdAt       DateTime      @default(now())

  @@index([conversationId])
}

// ----------------------------------------------------
// ORDERS & ESCROW TRANSACTIONS
// ----------------------------------------------------

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  totalAmount     Decimal       @db.Decimal(12, 2)
  currency        Currency      @default(BDT)
  status          OrderStatus   @default(PENDING_PAYMENT)
  
  shippingAddress String
  contactPhone    String

  buyerId         String
  buyer           User          @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Restrict)

  sellerId        String
  seller          User          @relation("SellerOrders", fields: [sellerId], references: [id], onDelete: Restrict)

  items           OrderItem[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([orderNumber])
  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
}

model OrderItem {
  id          String    @id @default(cuid())
  quantity    Int       @default(1)
  unitPrice   Decimal   @db.Decimal(12, 2)
  
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  listingId   String
  listing     Listing   @relation(fields: [listingId], references: [id], onDelete: Restrict)
}

// ----------------------------------------------------
// REVIEWS & TRUST RATINGS
// ----------------------------------------------------

model Review {
  id          String    @id @default(cuid())
  rating      Int       @default(5)
  comment     String?

  listingId   String
  listing     Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)

  buyerId     String
  buyer       User      @relation("BuyerReviews", fields: [buyerId], references: [id], onDelete: Cascade)

  sellerId    String
  seller      User      @relation("SellerReviews", fields: [sellerId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())

  @@index([sellerId])
  @@index([listingId])
}
